<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dumps an assembly's public API surface to a sorted, diffable text file. See Dump-PublicApi.ps1 for why. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NowUI.ApiDump</AssemblyName>
    <RootNamespace>NowUI.ApiDump</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>
</Project>
