<Project Sdk="Microsoft.NET.Sdk">
  <!--
    W2 to W5's acceptance, headless. Docs/Standalone/M3-Spec.md section 9.

    It references NowUI.Bridge's net9.0 target (see that project's header for why it has one) and NowUI.Runtime, so
    what these tests exercise is the bridge itself rather than a copy of its sources.

    W2 and W3 ran with NO resources - no fonts, no material templates - because identity is resolved before
    anything is measured or drawn, so a font-free host made that independence a measured property. W4's acceptance
    needs a real draw list and W5's needs a real click on a real rect, so the fixtures are served now; see the
    Tests.csproj reference below for why they arrive the way they do, and BridgeTestHost for what happens when
    they are absent.

    js/run.mjs is the JavaScript half of the same acceptance and is driven by JsChecks.cs, so `dotnet test` covers
    both sides of the boundary in one command.
  -->
  <PropertyGroup>
    <AssemblyName>NowUI.Bridge.Tests</AssemblyName>
    <RootNamespace>NowUI.Bridge.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <!--
      Matches Standalone/Tests: several NowUI diagnostics - CheckDuplicateControlId among them - are compiled under
      UNITY_EDITOR || DEVELOPMENT_BUILD, and the whole point of section 3.6 is that a Release wasm build does NOT
      have them. Defining it here means the backstop of Replay.Identity.cs can be exercised where it exists.
    -->
    <DefineConstants>$(DefineConstants);DEVELOPMENT_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NowUI.Bridge/NowUI.Bridge.csproj" />
    <ProjectReference Include="../NowUI.Runtime/NowUI.Runtime.csproj" />
    <ProjectReference Include="../NowUI.Engine/NowUI.Engine.csproj" />

    <!--
      W4's doing, and the reason is a visibility fact rather than a preference.

      W4's acceptance is that exactLayout on and off produce the same DRAW LIST against NowRecordingRenderBackend.
      A host that serves no resources produces no draw list: measured, a frame drawing a label, a button and a
      text field logs exactly two ops - BeginFrame(1) and EndFrame() - because Resources/NowUI/UIMaterial comes
      back null and every mesh path is skipped. So the fixtures exported for Standalone/Tests are reused through
      that project's public NowStandaloneTestResources.

      It cannot simply be <Compile Include>d here: it mints UnityEngine.Shader instances, whose constructor is
      internal to NowUI.Engine and granted only to the assembly literally named "Tests"
      (Standalone/NowUI.Engine/Graphics/Shader.cs:38). Compiling the source into this assembly is CS0122, and
      widening the grant would mean editing NowUI.Engine, which M3-Spec's header puts out of scope.

      It also carries NowInputReplay, the synthetic input provider from Assets/NowUITests/Support that Tests
      already compiles by reference - which is what turns W5's "fires exactly once per click" from an assertion
      about a bit into a pointer press and release at a coordinate. Compiling that file here as well produces
      CS0436 (the same type in two assemblies), so it is used from Tests rather than duplicated.

      What the reference costs: this project now builds the Unity test suite too (about 1.7 s incremental). What
      it does NOT do is run it - vstest runs the assembly it is given, and NUnit discovers fixtures in that
      assembly only, so `dotnet test` here still runs the bridge's own cases.
    -->
    <ProjectReference Include="../Tests/Tests.csproj" />
  </ItemGroup>


</Project>
