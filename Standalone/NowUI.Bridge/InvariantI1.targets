<Project>
  <!--
    Gate G10 - invariant I1. Docs/Standalone/M3-Spec.md section 3.3 and section 7.4.

    "Every container and every control the replay opens MUST be given an explicit id."

    This is a build failure rather than a test failure because of how the invariant fails when it is broken.
    NowLayout.Column() captures the BRIDGE's own [CallerFilePath]/[CallerLineNumber] (NowLayoutContainers.cs:251-256),
    so a container the bridge forgets to SetId does not throw, does not warn and does not draw differently - it falls
    into ResolveGroupSiteOccurrence with ONE site token shared by every container in the whole application, which is
    flat per-depth occurrence numbering (NowLayout.cs:2481-2498). That is the worst identity available and it is
    completely silent. Nothing downstream can see it; a scroll offset simply attaches to the wrong box under some
    other branch, some frames.

    W8's generator asserts this over the generated Replay.g.cs. Until the generator exists, the replay is
    hand-written, so the same assertion is made here by scanning the source. The scan is a heuristic and says so:
    it requires each factory chain to be one expression ending in .Begin() or .Draw(). Every chain in Replay*.cs is
    written that way, and a chain that is not is reported as unterminated rather than passed silently.

    To see it fail: delete the .SetId(...) from any chain in Replay.cs and build.
  -->

  <UsingTask TaskName="CheckInvariantI1"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Factories ParameterType="System.String" Required="true" />
      <IdFirstFactories ParameterType="System.String" Required="false" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string[] factories = Factories.Split(new char[] { ';' }, System.StringSplitOptions.RemoveEmptyEntries);
        string[] idFirst = (IdFirstFactories ?? "").Split(new char[] { ';' }, System.StringSplitOptions.RemoveEmptyEntries);
        int checkedChains = 0;

        foreach (var item in Files)
        {
            string path = item.GetMetadata("FullPath");
            if (!System.IO.File.Exists(path)) continue;

            string source = System.IO.File.ReadAllText(path);

            // Blank out comments and string literals before scanning, keeping every character position so line
            // numbers stay right. Without this the scan reads the file's own prose about NowLayout.Column() as a
            // call - which it did, the first time this target ran, and which is exactly the class of false
            // positive that makes a build gate get switched off.
            char[] scrubbed = source.ToCharArray();
            for (int i = 0; i < scrubbed.Length; i++)
            {
                char c = scrubbed[i];

                if (c == '/' && i + 1 < scrubbed.Length && scrubbed[i + 1] == '/')
                {
                    while (i < scrubbed.Length && scrubbed[i] != '\n') { scrubbed[i] = ' '; i++; }
                    i--;
                }
                else if (c == '/' && i + 1 < scrubbed.Length && scrubbed[i + 1] == '*')
                {
                    scrubbed[i] = ' ';
                    i++;
                    while (i < scrubbed.Length && !(scrubbed[i] == '*' && i + 1 < scrubbed.Length && scrubbed[i + 1] == '/'))
                    {
                        if (scrubbed[i] != '\n') scrubbed[i] = ' ';
                        i++;
                    }
                    if (i < scrubbed.Length) { scrubbed[i] = ' '; scrubbed[i + 1] = ' '; i++; }
                }
                else if (c == '"')
                {
                    i++;
                    while (i < scrubbed.Length && scrubbed[i] != '"')
                    {
                        if (scrubbed[i] == '\\') { scrubbed[i] = ' '; i++; }
                        if (i < scrubbed.Length && scrubbed[i] != '\n') scrubbed[i] = ' ';
                        i++;
                    }
                }
            }

            string text = new string(scrubbed);

            foreach (string rawFactory in factories)
            {
                string factory = rawFactory.Trim();
                if (factory.Length == 0) continue;

                string needle = factory + "(";
                int at = 0;

                while (true)
                {
                    int found = text.IndexOf(needle, at, System.StringComparison.Ordinal);
                    if (found < 0) break;
                    at = found + needle.Length;

                    // Skip a definition or a comment mention rather than a call: a call is preceded by
                    // whitespace, '(', '=', '?' or ':'. A '.' before the type name means it is qualified further,
                    // which is still a call.
                    if (found > 0)
                    {
                        char before = text[found - 1];
                        if (char.IsLetterOrDigit(before) || before == '_') continue;
                    }

                    // Walk the chain: from the '(' of the factory call to the ')' that closes .Begin() or
                    // .Draw(), or to whichever of ';', '{' or an unmatched ')' comes first.
                    int cursor = found + factory.Length;   // at the '('
                    int depth = 0;
                    int end = -1;
                    bool terminated = false;

                    for (int i = cursor; i < text.Length; i++)
                    {
                        char c = text[i];

                        if (c == '"')
                        {
                            // Step over a string literal so a ')' or ';' inside one cannot end the chain.
                            i++;
                            while (i < text.Length && text[i] != '"')
                            {
                                if (text[i] == '\\') i++;
                                i++;
                            }
                            continue;
                        }

                        if (c == '(') { depth++; continue; }

                        if (c == ')')
                        {
                            depth--;
                            if (depth < 0) { end = i; break; }

                            if (depth == 0)
                            {
                                // Which member just closed? If it is Begin or Draw, the chain is over.
                                int open = text.LastIndexOf('(', i);
                                int nameEnd = open;
                                int nameStart = nameEnd;
                                while (nameStart > 0 && (char.IsLetterOrDigit(text[nameStart - 1]) || text[nameStart - 1] == '_'))
                                    nameStart--;
                                string member = text.Substring(nameStart, nameEnd - nameStart);
                                if (member == "Begin" || member == "Draw")
                                {
                                    end = i + 1;
                                    terminated = true;
                                    break;
                                }
                            }
                            continue;
                        }

                        if (depth == 0 && (c == ';' || c == '{')) { end = i; break; }
                    }

                    if (end < 0) end = text.Length;

                    string chain = text.Substring(found, end - found);
                    checkedChains++;

                    int setIds = 0;
                    int scan = 0;
                    while (true)
                    {
                        int hit = chain.IndexOf(".SetId(", scan, System.StringComparison.Ordinal);
                        if (hit < 0) break;
                        setIds++;
                        scan = hit + 7;
                    }

                    int line = 1;
                    for (int i = 0; i < found; i++) if (text[i] == '\n') line++;

                    string oneLine = chain.Replace("\r", " ").Replace("\n", " ");
                    while (oneLine.Contains("  ")) oneLine = oneLine.Replace("  ", " ");
                    if (oneLine.Length > 160) oneLine = oneLine.Substring(0, 160) + "...";

                    if (!terminated)
                    {
                        Log.LogError(null, "NOWUI-I1", null, path, line, 1, 0, 0,
                            "Invariant I1: the factory chain starting at " + factory + "(...) does not end in " +
                            ".Begin() or .Draw(), so this check cannot see whether it carries a SetId. Write the " +
                            "chain as one expression. Chain: " + oneLine);
                    }
                    else if (setIds != 1)
                    {
                        Log.LogError(null, "NOWUI-I1", null, path, line, 1, 0, 0,
                            "Invariant I1 (M3-Spec section 3.3, gate G10): every container and every control the " +
                            "replay opens must carry EXACTLY ONE SetId, and this chain carries " + setIds + ". " +
                            "Without one it falls back to the bridge's own call site, which every container in the " +
                            "application shares, and its identity becomes flat per-depth occurrence numbering - " +
                            "silently. Chain: " + oneLine);
                    }
                }
            }

            // ---- the id-first factories ------------------------------------------------------------------
            //
            // W4's frame (section 5.7) opens the root through NowLayout.Area / NowLayout.RunMeasured, and
            // NEITHER takes its identity through .SetId(): both take a NowId as their FIRST ARGUMENT, and
            // RunMeasured is not a builder chain at all - it is a void call ending in a semicolon, so the walk
            // above would report it as "does not end in .Begin() or .Draw()".
            //
            // The invariant is unchanged; only the syntax that satisfies it differs. What I1 protects against is
            // a container falling back to the bridge's own [CallerFilePath]/[CallerLineNumber], which every
            // container in the application shares. `Area(new NowId(seg), rect, ...)` does not fall back - the id
            // is right there in the call - and `Area(rect, ...)` does. So for these two the check is: the first
            // argument must be an explicit NowId.
            //
            // This is narrower than the chain rule, not wider: an id-first factory called with anything else in
            // the first position is an error, including the plain `Area(rect)` overload that would otherwise
            // compile and silently take the bridge's site token.
            foreach (string rawFactory in idFirst)
            {
                string factory = rawFactory.Trim();
                if (factory.Length == 0) continue;

                string needle = factory + "(";
                int at = 0;

                while (true)
                {
                    int found = text.IndexOf(needle, at, System.StringComparison.Ordinal);
                    if (found < 0) break;
                    at = found + needle.Length;

                    if (found > 0)
                    {
                        char before = text[found - 1];
                        if (char.IsLetterOrDigit(before) || before == '_') continue;
                    }

                    checkedChains++;

                    int cursor = found + needle.Length;
                    while (cursor < text.Length && char.IsWhiteSpace(text[cursor])) cursor++;

                    int line = 1;
                    for (int i = 0; i < found; i++) if (text[i] == '\n') line++;

                    const string idPrefix = "new NowId(";
                    bool ok = cursor + idPrefix.Length <= text.Length &&
                              string.CompareOrdinal(text, cursor, idPrefix, 0, idPrefix.Length) == 0;

                    if (!ok)
                    {
                        int show = System.Math.Min(60, text.Length - found);
                        string snippet = text.Substring(found, show).Replace("\r", " ").Replace("\n", " ");
                        while (snippet.Contains("  ")) snippet = snippet.Replace("  ", " ");

                        Log.LogError(null, "NOWUI-I1", null, path, line, 1, 0, 0,
                            "Invariant I1 (M3-Spec section 3.3, gate G10): " + factory + " takes its identity as " +
                            "its FIRST argument, and this call does not pass one. Without an explicit NowId the " +
                            "root area falls back to the bridge's own call site, which every container in the " +
                            "application shares, and its identity becomes flat per-depth occurrence numbering - " +
                            "silently. Call: " + snippet + "...");
                    }
                }
            }
        }

        Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Normal,
            "Invariant I1: " + checkedChains + " factory chain(s) checked.");
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CheckInvariantI1" BeforeTargets="CoreCompile" Condition="'$(SkipInvariantI1)'!='true'">
    <ItemGroup>
      <!--
        The replay, and only the replay. Nothing else in this assembly opens a NowUI container or control, and
        widening the scan to files that merely mention one would turn a hard gate into a source of exceptions.
      -->
      <InvariantI1File Include="$(MSBuildThisFileDirectory)Replay*.cs" />
    </ItemGroup>

    <CheckInvariantI1 Files="@(InvariantI1File)"
                      Factories="NowLayout.Column;NowLayout.Row;NowLayout.Vertical;NowLayout.Horizontal;NowLayout.Button;NowLayout.Checkbox;NowLayout.Radio;NowLayout.Slider;NowLayout.TextField;NowLayout.TextArea;NowLayout.Dropdown;NowLayout.ComboBox;NowLayout.Foldout;NowLayout.SelectableRow;NowLayout.Toggle;NowLayout.ScrollView;NowLayout.Switch;NowLayout.Chip;NowLayout.TabBar;NowLayout.ColorPicker;NowLayout.DatePicker;NowLayout.TimePicker"
                      IdFirstFactories="NowLayout.Area;NowLayout.RunMeasured" />
  </Target>
</Project>
